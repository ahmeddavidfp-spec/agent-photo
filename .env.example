# ------------------------------------------------------------------
# Agent Photo — variables d'environnement (copier vers .env, ne PAS commit)
# ------------------------------------------------------------------

# Telegram
TELEGRAM_TOKEN=123456:ABC-DEF
# Secret optionnel : à fournir à setWebhook via secret_token.
# Telegram le renvoie dans le header X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=change-me-random-string
# Optionnel : filtrer sur un seul chat (le tien).
# Si vide, settings.py tombera sur TELEGRAM_CHAT_ID (nom historique).
ALLOWED_CHAT_ID=

# Instagram (Graph API)
IG_ACCESS_TOKEN=
# IG_USER_ID ou INSTAGRAM_BUSINESS_ID (les deux noms sont acceptés)
IG_USER_ID=
IG_CLIENT_SECRET=

# Threads (Graph API)
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
THREADS_CLIENT_SECRET=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Cron Render (protège /cron/*)
CRON_SECRET=another-random-string

# Facultatif : port (Render override)
PORT=10000
